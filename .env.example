# Copied to .env by `npm run setup` (scripts/init-env.mjs). change_me -> random secret. Never commit .env.
MYSQL_ROOT_PASSWORD=change_me
SP_DB_HOST=127.0.0.1
SP_DB_PORT=3310
SP_DB_DATABASE=stockdb
SP_APP_USER=stock_app
SP_APP_PASSWORD=change_me
SP_RO_USER=stock_ro
SP_RO_PASSWORD=change_me
# SEC EDGAR requires a descriptive User-Agent with a contact address; set your own before Phase 2 crawling.
SP_HTTP_UA=stock-predictor/0.1 (contact: set-your-email@example.com)
